# ─────────────────────────────────────────────────────────────
#  LomaShooes Pinterest Agent — Variables de Entorno
#  Copia este archivo como .env y rellena tus valores reales.
#  NUNCA subas .env a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# PINTEREST (https://developers.pinterest.com → My Apps → Tu app → Generate token)
# Permisos necesarios: boards:read, boards:write, pins:read, pins:write
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here

# SHOPIFY (Admin → Apps → Develop apps → Create app → Admin API access token)
# Permisos necesarios: read_products
SHOPIFY_STORE_URL=lomas-shoes.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_admin_api_token_here

# ANTHROPIC (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
